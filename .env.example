# ─────────────────────────────────────────────────────────────────────────────
# Data Room — every environment variable, documented.
#
# The API parses this set with a Zod schema at boot (apps/api/src/config/env.schema.ts).
# A missing or malformed variable exits non-zero naming the variable — never a failure at
# first use, halfway through a request.
#
# Copy to `.env` at the repo root for local development:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
# Matches docker-compose.yml. In production this is the Supabase pooled connection string.
#
# IN PRODUCTION THIS MUST CARRY `?sslmode=require` (or verify-ca / verify-full). node-postgres does
# not negotiate TLS unless it is asked to, and the API and the database are on different hosts in
# every deployed topology — without it, refresh-token hashes and share-recipient email addresses
# cross the public internet in plaintext. The env schema refuses to boot without it when
# NODE_ENV=production, because the failure is otherwise silent: it surfaces only if the server
# happens to *refuse* the cleartext connection. `sslmode=prefer` and `allow` do not count; both
# fall back to plaintext without saying so.
DATABASE_URL=postgres://dataroom:dataroom@localhost:5432/dataroom

# ── Google OAuth (W0-8) ──────────────────────────────────────────────────────
# Consent screen: External / Testing. Scopes: openid, email, profile — nothing more.
# BOTH redirect URIs must be registered in the Google Cloud console:
#   http://127.0.0.1:3000/api/v1/auth/google/callback
#   https://<render-service>.onrender.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:3000/api/v1/auth/google/callback

# ── Session tokens ───────────────────────────────────────────────────────────
# Two DISTINCT secrets, 32 characters minimum — HS256 wants 256 bits of entropy, and 32 characters
# is the floor below which a hand-typed passphrase stops being a key. Generate with:
#   openssl rand -base64 48
# Render generates these itself in production (see render.yaml); the rule bites on self-hosted and
# staging deploys, which is where a human picks the value.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-000000000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Refresh-cookie flags. Production (web on *.vercel.app, API on *.onrender.com) is cross-site,
# so it needs SameSite=None, which requires Secure, which requires HTTPS. Local development runs
# both on http://127.0.0.1, where SameSite=None would be dropped by the browser — hence Lax here.
# This is the one place local and production configuration legitimately differ (SPEC-02).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ── Object storage (Supabase Storage) ────────────────────────────────────────
# The service-role key is BACKEND-ONLY. It must never appear in anything the browser can read,
# and in particular must never be given a VITE_ prefix.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=dataroom
# Private bucket. There is no public object URL anywhere in this application.

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=104857600

# Requests per minute per client IP, across the whole API. The abuse-sensitive routes are narrowed
# further at the handler: 10/min for `GET /shared/:token`, 300/min for the auth routes, 120/min for
# `/health`. Loose by default because the bucket key is a client address and a whole office behind
# one NAT is a single key — this caps a script, it does not shape ordinary traffic.
RATE_LIMIT_PER_MINUTE=1200

# ── Deployment boundary ──────────────────────────────────────────────────────
# How many reverse proxies sit in front of this process, for Express's `trust proxy`.
#
# 0 locally (there is no proxy). 1 on Render, Fly, Heroku, and every other single-load-balancer
# platform. A *count*, never `true`: `true` trusts the whole X-Forwarded-For chain, so any caller
# could prepend a fake address and mint themselves an unlimited number of rate-limit buckets.
#
# Leaving this at 0 behind a proxy is not a subtle degradation — `req.ips` stays empty, every
# visitor on the internet keys to the same bucket, and the 10/min limit on the public share
# endpoint becomes 10/min for everybody. The env schema refuses to boot with 0 in production.
TRUST_PROXY_HOPS=0

# ── CORS / links ─────────────────────────────────────────────────────────────
# Exact origin, never a wildcard — a wildcard is incompatible with credentialed requests anyway.
# Also the base for public share links: ${WEB_ORIGIN}/s/<token>
#
# 127.0.0.1 rather than localhost, and it must match the address the browser is actually on. The
# README starts Vite with `--host 127.0.0.1`; an origin mismatch here does not surface as a CORS
# error page but as the signed-out landing screen, because every request the app makes is refused.
WEB_ORIGIN=http://127.0.0.1:5173

# ── Web app (Vite) ───────────────────────────────────────────────────────────
# Anything VITE_-prefixed is inlined into the browser bundle. Never put a secret here.
VITE_API_URL=http://127.0.0.1:3000
