# ─────────────────────────────────────────────────────────────────────────────
# Data Room — every environment variable, documented.
#
# The API parses this set with a Zod schema at boot (apps/api/src/config/env.schema.ts).
# A missing or malformed variable exits non-zero naming the variable — never a failure at
# first use, halfway through a request.
#
# Copy to `.env` at the repo root for local development:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
# Matches docker-compose.yml. In production this is the Supabase pooled connection string.
DATABASE_URL=postgres://dataroom:dataroom@localhost:5432/dataroom

# ── Google OAuth (W0-8) ──────────────────────────────────────────────────────
# Consent screen: External / Testing. Scopes: openid, email, profile — nothing more.
# BOTH redirect URIs must be registered in the Google Cloud console:
#   http://127.0.0.1:3000/api/v1/auth/google/callback
#   https://<render-service>.onrender.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:3000/api/v1/auth/google/callback

# ── Session tokens ───────────────────────────────────────────────────────────
# Two DISTINCT secrets. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-000000000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Refresh-cookie flags. Production (web on *.vercel.app, API on *.onrender.com) is cross-site,
# so it needs SameSite=None, which requires Secure, which requires HTTPS. Local development runs
# both on http://127.0.0.1, where SameSite=None would be dropped by the browser — hence Lax here.
# This is the one place local and production configuration legitimately differ (SPEC-02).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ── Object storage (Supabase Storage) ────────────────────────────────────────
# The service-role key is BACKEND-ONLY. It must never appear in anything the browser can read,
# and in particular must never be given a VITE_ prefix.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=dataroom
# Private bucket. There is no public object URL anywhere in this application.

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=104857600

# ── CORS / links ─────────────────────────────────────────────────────────────
# Exact origin, never a wildcard — a wildcard is incompatible with credentialed requests anyway.
# Also the base for public share links: ${WEB_ORIGIN}/s/<token>
#
# 127.0.0.1 rather than localhost, and it must match the address the browser is actually on. The
# README starts Vite with `--host 127.0.0.1`; an origin mismatch here does not surface as a CORS
# error page but as the signed-out landing screen, because every request the app makes is refused.
WEB_ORIGIN=http://127.0.0.1:5173

# ── Web app (Vite) ───────────────────────────────────────────────────────────
# Anything VITE_-prefixed is inlined into the browser bundle. Never put a secret here.
VITE_API_URL=http://127.0.0.1:3000
# `true` runs the web app against MSW with no backend at all.
VITE_USE_MSW=false
